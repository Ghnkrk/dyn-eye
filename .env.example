# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Google GenAI — VLM bounding-box annotation only
GEMINI_API_KEY=

# Groq — all text-LLM calls (training advisor, auto-retrain decision, optional prompt writer)
GROQ_API_KEY=

# Optional overrides (defaults live in config.py)
# VLM_MODEL_ID=gemma-4-31b-it
# LLM_MODEL_ID=qwen/qwen3.8-27b
# INSPECTION_DOMAIN=metallic
# USE_DYNAMIC_PROMPT=0
