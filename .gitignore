# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/

# Data (tracked by DVC — do not commit)
# Ignoring contents (data/*) rather than the directory itself (data/) —
# git can't re-include a file whose PARENT DIRECTORY was excluded, only
# individual excluded files, so the negations below need this form.
data/*
!data/.gitkeep
# DVC pointer files ARE meant to be git-tracked (src/retraining/tools/dvc_version.py
# runs `git add <dataset_dir>.dvc` as part of dataset versioning) — only the
# data they point to is DVC-managed, not the pointer itself.
!data/*.dvc

# Model artifacts (large binaries — use DVC or releases)
*.pt
models/versions/

# Logs & training runs
logs/
runs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# DVC — pointer files (*.dvc) are meant to be git-tracked, not ignored;
# DVC manages its own internal ignores under .dvc/ itself (dvc init writes
# .dvc/.gitignore for cache/tmp). Ignoring *.dvc here used to also match the
# .dvc/ directory DVC creates, making `dvc init` refuse to run at all.
/dvc.lock

# MLflow
mlruns/

# Environment secrets — NEVER commit
.env

# Docker local overrides
docker-compose.override.yml
.docker/

# Local database and sync locks
*.sqlite3
*.sqlite3-journal
.webassets-cache/

# Scratch / temp
*.tmp
*.bak
search_cols.py
sample_images.py
model.py
test_yolo.py
data details.txt
