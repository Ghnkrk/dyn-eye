# Copy to .env.local (git-ignored) and adjust if the backend isn't on localhost:8501.

# Used by next.config.ts to proxy /api/v2/* to the FastAPI backend.
API_PROXY_TARGET=http://localhost:8501

# Used by the browser directly for the WebSocket connection (store/useLiveStore.ts).
NEXT_PUBLIC_WS_URL=ws://localhost:8501/ws/stream
